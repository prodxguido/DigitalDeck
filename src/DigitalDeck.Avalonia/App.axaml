<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DigitalDeck.Avalonia"
             x:Class="DigitalDeck.Avalonia.App"
             RequestedThemeVariant="Dark">

    <!-- Los recursos van primero: los estilos de abajo los usan, y StaticResource se
         resuelve por orden léxico. -->
    <Application.Resources>
        <local:HexToBrushConverter x:Key="TileAccent" />
        <local:HexToBrushConverter x:Key="TileWash" Alpha="31" />
        <local:IconGeometryConverter x:Key="IconGeometry" />
        <local:IconImageConverter x:Key="IconImage" />

        <SolidColorBrush x:Key="Background" Color="#0B1013" />
        <SolidColorBrush x:Key="Surface" Color="#141B20" />
        <SolidColorBrush x:Key="Border" Color="#243038" />
        <SolidColorBrush x:Key="Text" Color="#E6EDF2" />
        <SolidColorBrush x:Key="TextDim" Color="#93A4B0" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1B242B" />
        <SolidColorBrush x:Key="Edge" Color="#33414C" />
        <SolidColorBrush x:Key="Accent" Color="#33C9DC" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--
            Fluent en oscuro sigue pintando los botones casi blancos, y un botón blanco al lado de
            un deck oscuro es lo primero que se ve. Esto los baja al mismo material que las tiras y
            las tarjetas: superficie, borde fino, esquinas redondeadas.
        -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="TextBlock.Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <!-- Prendido se nota por el acento, que es como se nota todo lo demás en esta app. -->
        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="TextBlock.Foreground" Value="#0B1013" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style Selector="CheckBox, RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Application.Styles>

</Application>
