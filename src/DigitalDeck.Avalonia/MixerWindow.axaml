<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DigitalDeck.ViewModels;assembly=DigitalDeck.ViewModels"
        xmlns:local="clr-namespace:DigitalDeck.Avalonia"
        x:Class="DigitalDeck.Avalonia.MixerWindow"
        Title="Mixer — DigitalDeck"
        Width="900" Height="560"
        MinWidth="360" MinHeight="420"
        Background="{StaticResource Background}">

    <Window.Resources>
        <local:LeftIndentConverter x:Key="LeftIndent" />
        <local:RgbToBrushConverter x:Key="RgbToBrush" />

        <!-- Una tira de canal: color de Live arriba, lectura, fader, nombre. -->
        <DataTemplate x:Key="ChannelStrip" DataType="vm:MixerChannelViewModel">
            <Border Width="70" Padding="0,0,0,8" CornerRadius="6"
                    Margin="{Binding IndentPixels, Converter={StaticResource LeftIndent}}"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <Border Height="4" CornerRadius="3,3,0,0"
                            Background="{Binding ColorRgb, Converter={StaticResource RgbToBrush},
                                         TargetNullValue={StaticResource Border}}" />

                    <TextBlock Text="{Binding Display}" Margin="0,7,0,6"
                               HorizontalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextDim}" />

                    <!--
                        Ancho de verdad y no un pelo: esta ventana se arrastra a una pantalla táctil
                        y se maneja con el dedo. 44 es la medida que recomiendan tanto Microsoft
                        como Apple para un blanco que se toca.
                    -->
                    <Slider Orientation="Vertical" Height="300" Width="44"
                            HorizontalAlignment="Center"
                            Minimum="0" Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}" />

                    <TextBlock Text="{Binding Name}" Margin="5,9,5,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxHeight="30"
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource Text}"
                               ToolTip.Tip="{Binding Name}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{StaticResource Surface}" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding ReturnsLabel}" IsVisible="{Binding HasReturns}" />
                <Button Content="{Binding CompactLabel}" IsVisible="{Binding HasGroups}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="14">

                <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelStrip}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Returns}" ItemTemplate="{StaticResource ChannelStrip}"
                              IsVisible="{Binding ShowReturnsPane}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ContentControl Content="{Binding Master}" ContentTemplate="{StaticResource ChannelStrip}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
