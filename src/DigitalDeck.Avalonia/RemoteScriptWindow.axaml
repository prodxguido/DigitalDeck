<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DigitalDeck.Avalonia.RemoteScriptWindow"
        Title="El puente con Ableton Live — DigitalDeck"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Padding="20">
            <StackPanel Spacing="10">

                <TextBlock x:Name="StateText" Foreground="{StaticResource Text}"
                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock x:Name="Detail" Foreground="{StaticResource TextDim}" FontSize="12"
                           TextWrapping="Wrap" />

                <TextBlock Text="DÓNDE VA" Foreground="{StaticResource TextDim}" FontSize="10.5"
                           Margin="0,8,0,0" />

                <ComboBox x:Name="LibraryBox" HorizontalAlignment="Stretch" />

                <TextBlock x:Name="NoLibrary" Foreground="{StaticResource TextDim}" FontSize="11.5"
                           TextWrapping="Wrap" IsVisible="False"
                           Text="No encontré la User Library de Ableton. Si Live está instalado, abrilo una vez para que la cree — en Mac cuelga de Music, en Windows de Documents." />

                <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="14"
                        Margin="0,10,0,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Después de instalar" Foreground="{StaticResource Text}"
                                   FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="1. Reiniciá Ableton Live. Live sólo lee los Remote Scripts al arrancar." />
                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="2. Preferencias → Link, Tempo &amp; MIDI → Control Surface: elegí «DigitalDeck»." />
                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="3. El indicador de la barra tiene que ponerse en verde." />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Result" FontSize="11.5" TextWrapping="Wrap"
                           IsVisible="False" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource Surface}" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cerrar" Click="Close_Click" />
                <Button x:Name="InstallButton" Content="Instalar" Click="Install_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
