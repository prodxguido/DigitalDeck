<Window x:Class="DigitalDeck.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel Margin="22,18,22,18">
            <TextBlock x:Name="TitleText" Text="Título"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14.5" FontWeight="SemiBold"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <TextBlock x:Name="PromptText" Text="Etiqueta"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="12" Margin="0,4,0,12" />

            <TextBox x:Name="ValueBox" KeyDown="ValueBox_KeyDown" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Aceptar" Style="{StaticResource PrimaryButton}"
                        Click="Accept_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
