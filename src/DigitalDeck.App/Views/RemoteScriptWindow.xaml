<Window x:Class="DigitalDeck.App.Views.RemoteScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="470"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- Same small caption the button editor uses. Local to each window, as it is there. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18">
            <TextBlock Text="Conectar con Ableton Live"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14.5" FontWeight="SemiBold"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <TextBlock Text="Ableton no tiene forma de que otra aplicación le hable. DigitalDeck instala un pequeño script que corre adentro de Live y le sirve de puente."
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />

            <!-- What the machine looks like right now. -->
            <Border Margin="0,16,0,0" Padding="13,11" CornerRadius="7"
                    Background="{StaticResource BackgroundBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="9" Height="9" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText" Margin="9,0,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="StateDetail" Margin="0,6,0,0"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11.5" TextWrapping="Wrap" />

                    <TextBlock x:Name="LocationText" Margin="0,7,0,0"
                               Foreground="{StaticResource TextFaintBrush}"
                               FontSize="10.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- The three steps, because getting them out of order is the usual way this fails:
                 Live reads Remote Scripts only when it starts. -->
            <TextBlock Text="Cómo queda andando" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />

            <StackPanel x:Name="StepsPanel">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                    <TextBlock x:Name="Step1Mark" Text="1" Width="18"
                               Foreground="{StaticResource TextFaintBrush}" FontSize="11.5" />
                    <TextBlock x:Name="Step1Text" Text="Instalar el script en tu User Library de Ableton."
                               Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                               TextWrapping="Wrap" Width="390" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                    <TextBlock Text="2" Width="18"
                               Foreground="{StaticResource TextFaintBrush}" FontSize="11.5" />
                    <TextBlock x:Name="Step2Text" Text="Abrir Ableton Live."
                               Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                               TextWrapping="Wrap" Width="390" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="3" Width="18"
                               Foreground="{StaticResource TextFaintBrush}" FontSize="11.5" />
                    <TextBlock Text="En Live: Preferencias → Link, Tempo &amp; MIDI → Control Surface, elegí «DigitalDeck» en un slot libre."
                               Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                               TextWrapping="Wrap" Width="390" />
                </StackPanel>
            </StackPanel>

            <!-- Which User Library. Only worth showing when there is a choice to make. -->
            <StackPanel x:Name="LibraryPanel" Margin="0,16,0,0">
                <TextBlock Text="Carpeta de Ableton" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <ComboBox x:Name="LibraryBox" SelectionChanged="Library_Changed" />
            </StackPanel>

            <Button x:Name="PickFolderButton" Content="Elegir otra carpeta…"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Margin="0,10,0,0" Click="PickFolder_Click" />

            <!-- Ports. Only interesting to somebody running AbletonOSC as well, which is why it
                 sits below the three steps rather than in front of them. -->
            <Expander x:Name="PortsExpander" Margin="0,16,0,0" Header="Puertos"
                      Expanded="Ports_Expanded">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource TextDimBrush}"
                               Text="AbletonOSC usa 11000 y 11001. Live puede tener los dos scripts cargados a la vez, pero no pueden compartir puerto: el segundo en arrancar se queda sordo. Por eso DigitalDeck usa otros." />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="El script escucha en" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ScriptPortBox" Width="90" TextChanged="Ports_Changed" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="La app escucha en" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AppPortBox" Width="90" TextChanged="Ports_Changed" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="PortsNote" Margin="0,10,0,0" TextWrapping="Wrap"
                               FontSize="11.5" Visibility="Collapsed" />
                </StackPanel>
            </Expander>

            <TextBlock x:Name="ResultText" Margin="0,14,0,0"
                       FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Para bajar el puente un rato sin perder la elección de puertos: instalar de
                     nuevo lo deja exactamente como estaba. -->
                <Button x:Name="UninstallButton" Grid.Column="0" Content="Desinstalar"
                        Style="{StaticResource SecondaryButton}" Click="Uninstall_Click" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Content="Cerrar" Style="{StaticResource SecondaryButton}"
                            Click="Close_Click" Margin="0,0,8,0" />
                    <Button x:Name="InstallButton" Content="Instalar el script"
                            Style="{StaticResource PrimaryButton}" Click="Install_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
