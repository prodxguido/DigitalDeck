<Window x:Class="DigitalDeck.App.Views.PageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel Margin="22,18,22,18">
            <TextBlock Text="Configurar página"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14.5" FontWeight="SemiBold"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <TextBlock Text="Nombre" Foreground="{StaticResource TextFaintBrush}"
                       FontSize="10.5" Margin="0,16,0,5" />
            <TextBox x:Name="NameBox" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Columnas" Foreground="{StaticResource TextFaintBrush}"
                               FontSize="10.5" Margin="0,0,0,5" />
                    <TextBox x:Name="ColumnsBox" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Filas" Foreground="{StaticResource TextFaintBrush}"
                               FontSize="10.5" Margin="0,0,0,5" />
                    <TextBox x:Name="RowsBox" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="WarningText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="11.5" TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
