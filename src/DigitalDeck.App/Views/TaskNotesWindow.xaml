<Window x:Class="DigitalDeck.App.Views.TaskNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tareas pendientes" Width="680" Height="440" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}">
    <Border BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="12" Background="{StaticResource ChromeBrush}" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel><TextBlock Text="NOTAS Y TAREAS" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Pendientes del workflow" Foreground="{StaticResource TextBrush}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource ChromeButton}" Content="×" FontSize="20" Padding="8,1" Click="Close_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="URGENTES" Foreground="#FF7777" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListBox x:Name="UrgentList" Background="Transparent" BorderThickness="0" SelectionChanged="Task_SelectionChanged"/>
                        <TextBlock Text="MEDIAS" Foreground="#F4C66A" FontSize="11" FontWeight="Bold" Margin="0,14,0,5"/>
                        <ListBox x:Name="MediumList" Background="Transparent" BorderThickness="0" SelectionChanged="Task_SelectionChanged"/>
                        <TextBlock Text="BAJAS" Foreground="#75D6A2" FontSize="11" FontWeight="Bold" Margin="0,14,0,5"/>
                        <ListBox x:Name="LowList" Background="Transparent" BorderThickness="0" SelectionChanged="Task_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Margin="16,0,0,0" Padding="16" Background="#18201F" BorderBrush="#2A3632" BorderThickness="1" CornerRadius="9">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="Elegí una tarea" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailDescription" Foreground="{StaticResource TextFaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,14"/>
                        <TextBlock Text="PASOS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                        <ItemsControl x:Name="StepsList" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
