<Window x:Class="DigitalDeck.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizar DigitalDeck" Width="460" Height="230" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}">
    <Border BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="12" Background="{StaticResource ChromeBrush}" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><TextBlock Text="ACTUALIZAR DIGITALDECK" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Style="{StaticResource ChromeButton}" Content="×" Padding="8,1" Click="Close_Click"/></Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Comprobando GitHub…" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True" Margin="0,12,0,0"/></StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenButton" Content="Ver release" Visibility="Collapsed" Style="{StaticResource ChromeButton}" Padding="10,5" Click="Open_Click"/><Button Content="Cerrar" Style="{StaticResource ChromeButton}" Padding="10,5" Margin="8,0,0,0" Click="Close_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
