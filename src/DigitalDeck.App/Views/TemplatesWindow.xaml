<Window x:Class="DigitalDeck.App.Views.TemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar plantillas"
        Width="520" Height="640"
        MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Plantillas incluidas" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{StaticResource TextDimBrush}"
                       Text="Vienen adentro de la app. Elegí las que quieras y decidí abajo cómo entran; en cualquiera de los dos casos, nada de lo que ya tenías se mueve." />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <ItemsControl x:Name="TemplateList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Toda la fila es el área de clic: una lista de tildes donde hay que
                                 acertarle al cuadradito es peor con el dedo y no mejor con el mouse. -->
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="10,7" Padding="9,0,0,0"
                                      VerticalContentAlignment="Center"
                                      Foreground="{StaticResource TextBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="30"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource TextFaintBrush}"
                   Visibility="Collapsed"
                   Text="Esta versión de la app no trae plantillas adentro." />

        <!-- La pregunta que antes no se hacía. Una marca con quince plugins es una pantalla, no un
             botón, y quien esté armando una sola página con las tres marcas que usa tampoco está
             equivocado: lo único seguro es que la app no lo sabe. -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="¿Cómo querés que entren?" FontSize="11.5"
                       Foreground="{StaticResource TextDimBrush}" />

            <RadioButton x:Name="AsPageOption" GroupName="ImportTarget" IsChecked="True"
                         Margin="0,9,0,0" Padding="7,0,0,0"
                         VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}">
                <StackPanel>
                    <TextBlock Text="Cada una como una página nueva" FontSize="12.5" />
                    <TextBlock Text="Se suman pestañas al costado, con los botones ya desplegados."
                               FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextFaintBrush}" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="AsGroupOption" GroupName="ImportTarget"
                         Margin="0,8,0,0" Padding="7,0,0,0"
                         VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}">
                <StackPanel>
                    <TextBlock Text="Como un grupo en la página que estoy usando" FontSize="12.5" />
                    <TextBlock Text="Cada una ocupa un botón; se abre y adentro están los demás."
                               FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextFaintBrush}" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Content="Marcar todas" Click="SelectAll_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancelar"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}"
                        Content="Instalar" Click="Install_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
