<Window x:Class="DigitalDeck.App.Views.DuplicateNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="500"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel Margin="22,18,22,18">
            <TextBlock Text="Nombres repetidos"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14.5" FontWeight="SemiBold"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <TextBlock Text="Cuando dos botones se llaman igual, el asistente de voz no dispara ninguno: no sabe cuál elegís. Renombrá uno para deshacer el empate."
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />

            <TextBlock x:Name="EmptyHint"
                       Text="No hay nombres repetidos. El asistente puede disparar cualquier botón por su nombre."
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"
                       Visibility="Collapsed" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Margin="0,14,0,0"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CollisionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="13,11" CornerRadius="7"
                                    Background="{StaticResource BackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12.5" FontWeight="SemiBold" />

                                    <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Location}"
                                                                       Foreground="{StaticResource TextDimBrush}"
                                                                       FontSize="11" />
                                                            <TextBlock Text="  (gana este por voz)"
                                                                       Foreground="{StaticResource TextFaintBrush}"
                                                                       FontSize="11"
                                                                       Visibility="{Binding IsWinnerVisibility}" />
                                                        </StackPanel>
                                                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="12"
                                                                 Padding="8,6"
                                                                 Margin="0,4,0,0"
                                                                 Background="{StaticResource SurfaceBrush}"
                                                                 Foreground="{StaticResource TextBrush}"
                                                                 BorderBrush="{StaticResource BorderBrush}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Content="Guardar"
                                                            VerticalAlignment="Bottom"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Click="Save_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="ErrorHint" Margin="0,2,0,0"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="11" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Listo" Style="{StaticResource PrimaryButton}" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
