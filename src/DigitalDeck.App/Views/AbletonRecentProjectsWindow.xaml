<Window x:Class="DigitalDeck.App.Views.AbletonRecentProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proyectos recientes de Ableton"
        Width="430" Height="520" MinWidth="360" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
    <Border BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="12" Background="{StaticResource ChromeBrush}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="PROYECTOS RECIENTES" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Ableton Live" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="▣" FontSize="15" Padding="8,3" Click="Calendar_Click" ToolTip="Filtrar por fecha"/>
                    <Button Style="{StaticResource ChromeButton}" Content="×" FontSize="20" Padding="8,1" Click="Close_Click" ToolTip="Cerrar"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,14,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="32" Padding="10,5" TextChanged="SearchBox_TextChanged" ToolTip="Buscar por nombre o ruta"/>
                <ComboBox x:Name="LimitBox" Grid.Column="1" Width="92" Height="32" Margin="8,0,0,0" SelectionChanged="LimitBox_SelectionChanged" ToolTip="Cantidad de proyectos">
                    <ComboBoxItem Content="25" Tag="25" IsSelected="True"/>
                    <ComboBoxItem Content="50" Tag="50"/>
                    <ComboBoxItem Content="100" Tag="100"/>
                    <ComboBoxItem Content="Todos" Tag="0"/>
                </ComboBox>
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="⟳" Width="32" Height="32" Margin="8,0,0,0" Click="RefreshCatalog_Click" ToolTip="Analizar las unidades y actualizar el catálogo"/>
            </Grid>
            <Border x:Name="DateFilterPanel" Grid.Row="2" Visibility="Collapsed" Background="#18201F" BorderBrush="#2A3632" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Desde" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="StartDatePicker" Width="125" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                    <TextBlock Text="Hasta" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <DatePicker x:Name="EndDatePicker" Width="125" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                    <Button Style="{StaticResource ChromeButton}" Content="Limpiar" Margin="8,0,0,0" Padding="8,4" Click="ClearDates_Click"/>
                </StackPanel>
            </Border>
            <ListBox x:Name="ProjectsList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="ProjectsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,9" Margin="0,0,0,5" CornerRadius="8" Background="#18201F" BorderBrush="#2A3632" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextFaintBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayDate}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Top" Margin="10,2,0,0"/>
                                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="⌂" Padding="7,3" Margin="8,0,0,0" Tag="{Binding}" Click="OpenProjectFolder_Click" ToolTip="Abrir la carpeta del proyecto"/>
                                <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="↗" Padding="7,3" Margin="4,0,0,0" Tag="{Binding}" Click="ShareProject_Click" ToolTip="Comprimir y subir el proyecto a GoFile"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Grid.Row="3" Text="No encontré proyectos recientes de Ableton." Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="CountText" Grid.Row="4" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="2,10,0,0"/>
        </Grid>
    </Border>
</Window>
