<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Studio-dark palette. Neutrals carry a slight blue bias toward the accent so the greys read
        as chosen rather than inherited, and the accent is spent almost entirely on one thing:
        what is currently active.
    -->
    <Color x:Key="BackgroundColor">#111313</Color>
    <Color x:Key="SurfaceColor">#191C1C</Color>
    <Color x:Key="SurfaceRaisedColor">#242929</Color>
    <Color x:Key="BorderColor">#313737</Color>
    <Color x:Key="TextColor">#F1F2EC</Color>
    <Color x:Key="TextDimColor">#B0B8B4</Color>
    <Color x:Key="TextFaintColor">#86928C</Color>
    <Color x:Key="AccentColor">#D4EE86</Color>
    <Color x:Key="DangerColor">#E8615F</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- A hairline that reads as a lit top edge rather than a drawn box: brighter where light
         would fall, gone by the bottom. It is what separates a raised surface from a rectangle
         somebody painted a border around. -->
    <LinearGradientBrush x:Key="EdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4B5650" />
        <GradientStop Offset="0.5" Color="#313737" />
        <GradientStop Offset="1" Color="#252D29" />
    </LinearGradientBrush>

    <!-- Chrome bars get a barely-there vertical fall so a 46px slab is not a flat fill. -->
    <LinearGradientBrush x:Key="ChromeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#202624" />
        <GradientStop Offset="1" Color="#171B19" />
    </LinearGradientBrush>

    <!-- Washes are white at low alpha rather than a named grey, so one hover colour works on every
         surface: over the background, over a raised card, over an accent-tinted tile. -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FFFFFF" Opacity="0.06" />
    <SolidColorBrush x:Key="PressBrush" Color="#000000" Opacity="0.12" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#0B1013" Opacity="0.9" />

    <!--
        ===== Motion =====
        One vocabulary, three speeds, one curve. Micro is for something that has to feel like a
        direct consequence of the pointer; Enter is for something arriving on screen; Exit is
        quicker than Enter, because a thing leaving should never make you wait for it. The curve
        is always ease-out: motion starts at full speed and settles, which reads as responsive
        instead of as an animation being played at you.
    -->
    <Duration x:Key="MicroDuration">0:0:0.11</Duration>
    <Duration x:Key="EnterDuration">0:0:0.19</Duration>
    <Duration x:Key="ExitDuration">0:0:0.13</Duration>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <QuadraticEase x:Key="EaseOutSoft" EasingMode="EaseOut" />

    <!--
        ===== Elevation =====
        Shadows are expensive in WPF — a real per-pixel blur, not a compositor trick — so they are
        spent only on things that float over other things: popups, cards, the one tile under the
        pointer. Never on something that is merely present. The deck can show sixty tiles at once,
        and sixty shadows would cost more than the whole rest of the frame.
    -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="5" Direction="270"
                      Opacity="0.42" Color="#05070B" />
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="30" ShadowDepth="7" Direction="270"
                      Opacity="0.55" Color="#05070B" />
    <DropShadowEffect x:Key="LiftShadow" BlurRadius="18" ShadowDepth="4" Direction="270"
                      Opacity="0.5" Color="#05070B" />

    <!-- Segoe UI Variable is the Windows 11 face and is optically sized: Display for headings,
         Text for body. It falls back to plain Segoe UI on Windows 10, which is what was here
         before, so nothing breaks on an older machine. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Line icons (Lucide): always stroked, never filled; round cap and join at 2 units on the
         24-grid. Each use sets its own Data and Stroke brush. -->
    <Style x:Key="LineIcon" TargetType="Path">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!--
        ===== Focus =====
        The WPF default focus visual is a 1px dotted rectangle drawn in 2006 and never revisited.
        On a dark surface it is nearly invisible, and where it is visible it looks like a
        rendering fault. This replaces it with a soft accent ring set just outside the control.
    -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="7" Margin="-2"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                            Opacity="0.7" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== Chrome button =====
        Used across the top and bottom bars, the breadcrumb and the page tabs. The hover wash is a
        separate layer animated by opacity rather than a background swap, for two reasons: several
        call sites bind Background to a converter (which page is open, which grid size is set) and
        a trigger overwriting it would fight that binding; and opacity is the one thing that can
        be animated here without touching a frozen shared brush. The press dip is 3% of scale —
        small enough that you feel it rather than watch it.
    -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Squeeze" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8" />
                        <Border x:Name="Wash"
                                Background="{StaticResource HoverBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MicroDuration}"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource ExitDuration}"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource MicroDuration}"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource MicroDuration}"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
